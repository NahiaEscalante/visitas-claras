# ─── Visitas Claras — Variables de entorno ───
#
# Si VITE_API_BASE_URL NO está definida, la app funciona en modo demo/mock.
# Si VITE_API_BASE_URL ESTÁ definida, la app se conecta al backend real.

# URL base del backend API (sin trailing slash)
# Desarrollo local:
# VITE_API_BASE_URL=http://localhost:8000
#
# Producción:
# VITE_API_BASE_URL=https://api.visitas-claras.com
